<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>eShop.Assistant.Tools</RootNamespace>
  </PropertyGroup>

  <!-- Deliberately no ASP.NET Core framework reference: the tools know nothing about HttpContext, ClaimsPrincipal or Blazor. -->
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http.Client" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
